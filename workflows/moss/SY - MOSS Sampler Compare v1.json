   "properties": {
    "Node name for S&R": "SYWorkflowHeader",
    "sy_title": "MOSS Sampler Compare",
    "sy_subtitle": "Made with Stable Yogi Nodes (SY Nodes) by Stable Yogi",
    "sy_install": "Stable Yogi Nodes (SY Nodes): search \"SY Nodes\" in ComfyUI Manager, or use the folder sy-comfyui-nodes.\nComfyUI 0.43 or newer (the MOSS-Image nodes are built in).",
    "sy_howto": "1. Write your prompt.\n2. In Sampler Sweep SY type the pairs to compare, one per line: sampler + scheduler.\n3. Press Run. You get one sheet with every picture, its pair and its time, and a time table, fastest first.",
    "sy_info": "Sampler Sweep SY: same prompt and seed for every pair, so only the sampler and scheduler change.\nImage Grid SY: puts the pictures on one sheet with a caption under each.\nSave Result SY: saves the sheet with the time table beside it.\nMeasured on MOSS-Image at 1024 x 1024, 25 steps: most pairs take about 10 s; dpmpp_2m_sde about 15 s, dpmpp_sde about 27 s. karras and kl_optimal spoil MOSS pictures."
   },
   "widgets_values": [
    ""
